{
  "name": "automation-framework",
  "version": "1.0.0",
  "description": "A robust automation framework using CodeceptJS with Playwright for end-to-end testing.",
  "keywords": [
    "automation",
    "testing",
    "codeceptjs",
    "playwright",
    "bdd",
    "cucumber",
    "chai",
    "allure"
  ],
  "homepage": "https://www.github.com/hexdee606",
  "license": "CC0-1.0",
  "author": "hexdee606 <10842172+hexdee606@users.noreply.github.com>",
  "contributors": [],
  "main": "index.js",
  "directories": {
    "config": "./config",
    "custom_helpers": "./custom_helpers",
    "inputs": "./inputs",
    "outputs": "./outputs",
    "src": "./src",
    "features": "./src/features",
    "model": "./src/model",
    "pages": "./src/pages",
    "servers": "./src/servers",
    "services": "./src/services",
    "step_definitions": "./src/step_definitions"
  },
  "scripts": {
    "test:run": "codeceptjs run --debug --plugins allure --config=./codecept.conf.js",
    "test:report-serve": "allure serve ./outputs/allure-results --clean",
    "test:debug": "codeceptjs run --debug --grep \"@debug\" --plugins allure --config=./codecept.conf.js",
    "test:report-generate": "allure generate ./outputs/allure-results --clean -o ./allure-report",
    "test:e2e": "codeceptjs run --plugins allure --config=./codecept.conf.js",
    "test:parallel": "codeceptjs run-multiple --all --plugins allure --config=./codecept.conf.js",
    "test:report-open": "allure open ./allure-report"
  },
  "config": {
    "logLevel": "info"
  },
  "dependencies": {
    "@codeceptjs/configure": "^1.0.1",
    "axios": "^1.7.9",
    "chai": "^4.5.0",
    "codeceptjs": "^3.6.10",
    "exceljs": "^4.4.0",
    "import-export": "^1.0.1",
    "mongoose": "^8.9.2",
    "playwright": "^1.49.1",
    "puppeteer-core": "^23.11.1",
    "@cucumber/cucumber": "^11.1.1",
    "@cucumber/cucumber-expressions": "^18.0.1",
    "@cucumber/gherkin": "^30.0.4",
    "rimraf": "^6.0.1",
    "glob": "^11.0.0",
    "uuid": "^11.0.3",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@codeceptjs/allure-legacy": "^1.0.2",
    "@types/node": "^22.10.2",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.7",
    "codeceptjs-browserlogs-plugin": "^1.0.6",
    "debug": "^4.4.0",
    "moment": "^2.30.1"
  },
  "engines": {
    "node": ">=20.16.0",
    "npm": ">=10.8.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexdee606/e2e-codeceptjs-boilerplate.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "workspaces": []
}
